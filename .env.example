# ==========================================
# ViewRoom Full-Stack Environment Variables
# ==========================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Neon PostgreSQL Database (Prisma ORM)
DATABASE_URL="postgresql://username:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication
JWT_SECRET="viewroom_jwt_secret_key_super_secure_360_platform"
JWT_EXPIRES_IN="7d"

# Google Gemini AI (For Spatial Concierge & Voice Intent Matcher)
GEMINI_API_KEY="your_google_gemini_api_key_here"

# Cloudinary Cloud Media Storage
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

