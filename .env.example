# ==========================================
# ViewRoom Full-Stack Environment Variables
# ==========================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Neon PostgreSQL Database (Prisma ORM)
DATABASE_URL="postgresql://username:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication
JWT_SECRET="viewroom_jwt_secret_key_super_secure_360_platform"
JWT_EXPIRES_IN="7d"

# Google Gemini AI (For Spatial Concierge & Voice Intent Matcher)
GEMINI_API_KEY="your_google_gemini_api_key_here"

# S3 / Cloudflare R2 Media Storage (Optional)
S3_BUCKET_NAME="viewroom-media"
S3_REGION="auto"
S3_ACCESS_KEY_ID="your_s3_access_key"
S3_SECRET_ACCESS_KEY="your_s3_secret_key"
S3_ENDPOINT="https://your_cloudflare_r2_endpoint.r2.cloudflarestorage.com"
