datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// User & Authentication Schema
model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String?
  passwordHash  String?
  role          Role           @default(CLIENT)
  tours         VirtualTour[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([role])
}

enum Role {
  ADMIN
  CREATOR
  CLIENT
  VISITOR
}

// 360° Virtual Tour & Scene Models
model VirtualTour {
  id            String         @id @default(uuid())
  title         String
  description   String?
  category      String
  coverImage    String?
  brandLogo     String?        // Space / Property Brand Logo (Cafe, Hotel, Home, Office)
  audioConfig   String?        // JSON string containing ambient audio track preferences & custom URL
  floorPlanUrl  String?
  sqft          Int?
  isPublished   Boolean        @default(true)
  authorId      String
  author        User           @relation(fields: [authorId], references: [id])
  scenes        Scene[]
  analytics     Analytics[]
  createdAt     DateTime       @default(now())

  @@index([authorId])
  @@index([category])
  @@index([isPublished])
  @@index([createdAt])
}

model Scene {
  id            String         @id @default(uuid())
  tourId        String
  tour          VirtualTour    @relation(fields: [tourId], references: [id], onDelete: Cascade)
  name          String
  floorLevel    String
  thumbnailUrl  String
  panoramaUrl   String
  defaultYaw    String?        @default("0deg")
  defaultPitch  String?        @default("0deg")
  orderIndex    Int            @default(0)
  hotspots      Hotspot[]

  @@index([tourId])
  @@index([orderIndex])
}

model Hotspot {
  id            String         @id @default(uuid())
  sceneId       String
  scene         Scene          @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  type          HotspotType
  yaw           Float          // Spherical Yaw Angle (-180 to 180)
  pitch         Float          // Spherical Pitch Angle (-90 to 90)
  targetSceneId String?        // Destination Scene ID
  label         String
  description   String?

  @@index([sceneId])
  @@index([targetSceneId])
}

enum HotspotType {
  RING
  DOOR
  CHEVRON
  TARGET
  INFO
}

// Analytics & Heatmaps
model Analytics {
  id            String         @id @default(uuid())
  tourId        String
  tour          VirtualTour    @relation(fields: [tourId], references: [id])
  viewsCount    Int            @default(0)
  durationSec   Int            @default(0)
  createdAt     DateTime       @default(now())

  @@index([tourId])
}

// Contact Messages Submitted via Website
model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}
