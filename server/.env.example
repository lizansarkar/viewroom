# Server Environment Variables
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/viewroom?schema=public"

# JWT Authentication Secret
JWT_SECRET="viewroom_jwt_secret_key_super_secure_360_platform"
JWT_EXPIRES_IN="7d"

# Google Gemini AI API Key (For Spatial AI Concierge)
GEMINI_API_KEY="your_google_gemini_api_key_here"

# Cloudflare R2 / AWS S3 Object Storage Credentials (Optional)
S3_BUCKET_NAME="viewroom-media"
S3_REGION="auto"
S3_ACCESS_KEY_ID="your_s3_access_key"
S3_SECRET_ACCESS_KEY="your_s3_secret_key"
S3_ENDPOINT="https://your_cloudflare_r2_endpoint.r2.cloudflarestorage.com"
